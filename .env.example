# Example configuration, aligned with the `env:` block of the `test` job in
# .github/workflows/ci.yml. Copy it to `.env` to run the suite locally:
#
#     cp .env.example .env && cargo test --locked
#
# `.env` is gitignored. Without it, most of `cargo test` fails on a bare
# `SERVER_ADDRESS must be set` panic, because configuration is mandatory with
# no code defaults for the security-critical values.
#
# These are TEST values. They are not a deployment template: the buckets are
# deliberately wide open so a test never fails on an unrelated global limit
# (see the "Test-writing traps" section of SECURITY.md), and the cooldown is
# one minute so expiry tests stay fast. For production values and their
# rationale, follow the README and docs/DEPLOYMENT.md.

# Required: the server refuses to start without these.
DATABASE_URL=test_db.sqlite3
SERVER_ADDRESS=127.0.0.1:3000
SECRET_MAX_LENGTH=128
CANARY=🐦
RATE_LIMIT_COOLDOWN=1
RATE_LIMIT_MAX_ATTEMPTS=3

# Optional, with code defaults. The values below are the CI values.
# Every test allocates its own SQLite file, so TEST_DATABASE_URL is ignored.
TEST_DATABASE_URL=test_db.sqlite3
STORE_RATE_LIMIT_BURST=10000
STORE_RATE_LIMIT_REFILL_PER_SECOND=10000
LOOKUP_RATE_LIMIT_BURST=10000
LOOKUP_RATE_LIMIT_REFILL_PER_SECOND=10000
RATE_LIMIT_MAX_IDENTIFIERS=100000
DATABASE_MAX_CONCURRENCY=16
# Must be shorter than RATE_LIMIT_COOLDOWN (one minute above): the code
# default of 60 s would be refused at startup with a one-minute cooldown.
ATTEMPTS_SNAPSHOT_TTL_SECONDS=30

# Whole-process memory budget the identifier-map capacity is validated
# against. Startup uses the LOWER of this value and the limit the kernel
# actually enforces (cgroup memory.max), so this matters most when the service
# runs without a cgroup limit. Keep it equal to MemoryMax=512M in
# deploy/systemd/recoverbull.service. Startup refuses a capacity whose
# estimated snapshot peak does not fit.
RATE_LIMIT_MEMORY_BUDGET_MB=512
