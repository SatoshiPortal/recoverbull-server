# Production configuration. For a new installation, copy to .env in the
# server's working directory, then review the database path.
# Keep an existing installation's .env and database path; see docs/OPERATIONS.md.
# Tests use tests/fixtures/server.env instead; see README.md.

# New local instance only: relative to the working directory. On a deployed
# host, set the actual absolute database path. A new path creates an empty DB.
DATABASE_URL=production_db.sqlite3
# Match both nginx proxy_pass directives; keep this listener on loopback.
SERVER_ADDRESS=127.0.0.1:3001

# Public warrant canary expected exactly by standard RecoverBull clients.
# Keep this value for normal operation. It is not a secret or placeholder.
# An empty CANARY= signals compromise; an absent key prevents startup.
CANARY=🐦

# Protocol limits. Cooldown is in MINUTES: 1440 is 24 hours.
SECRET_MAX_LENGTH=128
RATE_LIMIT_COOLDOWN=1440
RATE_LIMIT_MAX_ATTEMPTS=3

# Global limits, matching the production defaults in code.
STORE_RATE_LIMIT_BURST=10
STORE_RATE_LIMIT_REFILL_PER_SECOND=2
LOOKUP_RATE_LIMIT_BURST=100
LOOKUP_RATE_LIMIT_REFILL_PER_SECOND=5
ATTEMPTS_RATE_LIMIT_BURST=20
ATTEMPTS_RATE_LIMIT_REFILL_PER_SECOND=2
ATTEMPTS_SNAPSHOT_TTL_SECONDS=60

# Capacity and concurrency. Match the service's actual memory limit
# (MemoryMax= for systemd); startup validates capacity against this budget.
RATE_LIMIT_MAX_IDENTIFIERS=100000
RATE_LIMIT_MEMORY_BUDGET_MB=512
DATABASE_MAX_CONCURRENCY=16

# Refuse /store below this much free space on the database volume.
# Keep a reserve: 0 disables this protection.
STORAGE_RESERVE_MB=64

# RUST_LOG is read before .env is loaded. Never enable trace logging.
