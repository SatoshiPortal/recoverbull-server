# Unsupported nginx migration aid only. The reference Caddy proxy logs to
# journald and does not use this file. Operators retaining nginx must adapt
# these periods and document them under docs/RETENTION.md.
/var/log/nginx/recoverbull-error.log {
    weekly
    rotate 4
    compress
    missingok
    notifempty
    create 0640 root adm
    postrotate
        systemctl reload nginx >/dev/null 2>&1 || true
    endscript
}
