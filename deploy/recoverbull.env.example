# Production configuration for RecoverBull.
# `deploy/recoverbull install` writes this file, with your canary, to
# /var/lib/recoverbull/.env (root-owned, readable by the service). Edit it
# there, as root, not here.
# For test values, see .env.example at the repository root.

# Warrant canary served by /info, set by the install (--canary or a prompt).
# Edit it at any time: /info serves the new value within ten minutes.
# Deleting the line serves an empty canary, which clients read as "compromised".
CANARY=CHANGE_ME

# Do not change the next two lines: the systemd unit and nginx expect them.
DATABASE_URL=/var/lib/recoverbull/database.sqlite3
SERVER_ADDRESS=127.0.0.1:3001

# Protocol parameters announced to clients through /info.
# Longest encrypted secret accepted, in Base64 characters (128 to 832).
SECRET_MAX_LENGTH=128
# Minutes during which an identifier's attempt budget stays spent (max 1440).
RATE_LIMIT_COOLDOWN=1440
# Distinct passwords one identifier may try per cooldown.
RATE_LIMIT_MAX_ATTEMPTS=3

# Keep equal to MemoryMax= in /etc/systemd/system/recoverbull.service.
RATE_LIMIT_MEMORY_BUDGET_MB=512

# Every other setting has a safe default; see docs/OPERATIONS.md before changing one.
# RUST_LOG is read before this file is loaded, so it cannot be set here.
