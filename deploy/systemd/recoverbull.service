# Operator-adapted example; see deploy/README.md. Validate the installed unit,
# resource limits, filesystem paths, journal policy, and service identity.
[Unit]
Description=RecoverBull keychain server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recoverbull
Group=recoverbull
WorkingDirectory=/var/lib/recoverbull
ExecStart=/opt/recoverbull/bin/keychain
Restart=no
TimeoutStopSec=40s
LimitCORE=0
UMask=0077
MemoryMax=512M
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
ReadWritePaths=/var/lib/recoverbull
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Hardening (AUD-10). These raise the systemd-analyze exposure score and are
# safe for this process (loopback TCP to the reverse proxy, SQLite/WAL on the
# ReadWritePaths volume, a plain multi-thread Tokio runtime). PrivateNetwork is
# deliberately NOT set: the process must remain reachable on loopback by the
# proxy. Validate each directive against the installed build before relying on
# it, as deploy/README.md requires.
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Enforce the loopback-only model the binary can only warn about.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
