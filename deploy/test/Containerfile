# Debian 13 with systemd, to try the deployment in a container instead of a
# VM. The install script drives systemd units, so a plain debian image
# cannot run it. Build and run with podman; inside, work as the sudo user
# `op` (privileged: the hardened unit needs namespaces and device isolation):
#
#   podman build -t recoverbull-debian13 -f deploy/test/Containerfile .
#   podman run -d --name recoverbull-test --privileged --systemd=always \
#     --memory 2g recoverbull-debian13
#   podman exec -it -u op -w /home/op recoverbull-test bash -l
#
# Then follow docs/OPERATIONS.md from "Install". Remove it with
# `podman rm -f recoverbull-test`. This is a test bench, not a way to run
# the server in production: see docs/OPERATIONS.md for the host.
FROM docker.io/library/debian:trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv sudo ca-certificates build-essential git curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash op \
 && echo 'op ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/op
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
