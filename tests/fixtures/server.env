# TESTS ONLY. Export inside a subshell; never copy this to a deployed .env.
# Wide global buckets keep tests focused on the behavior under test.
# Each unit test allocates its own temporary SQLite database.
DATABASE_URL=test_db.sqlite3
SERVER_ADDRESS=127.0.0.1:3000
SECRET_MAX_LENGTH=128
CANARY=🐦
RATE_LIMIT_COOLDOWN=1
RATE_LIMIT_MAX_ATTEMPTS=3
STORE_RATE_LIMIT_BURST=10000
STORE_RATE_LIMIT_REFILL_PER_SECOND=10000
LOOKUP_RATE_LIMIT_BURST=10000
LOOKUP_RATE_LIMIT_REFILL_PER_SECOND=10000
ATTEMPTS_RATE_LIMIT_BURST=20
ATTEMPTS_RATE_LIMIT_REFILL_PER_SECOND=2
# Must remain shorter than the one-minute test cooldown.
ATTEMPTS_SNAPSHOT_TTL_SECONDS=30
RATE_LIMIT_MAX_IDENTIFIERS=100000
RATE_LIMIT_MEMORY_BUDGET_MB=512
DATABASE_MAX_CONCURRENCY=16
# Storage-pressure tests exercise the boundary at 63 and 65 MiB.
STORAGE_RESERVE_MB=64
